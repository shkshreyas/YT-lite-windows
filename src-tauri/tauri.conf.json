{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Lite",
  "version": "1.0.0",
  "identifier": "com.ytlite.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT Lite",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
