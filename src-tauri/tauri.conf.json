{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Lite",
  "version": "1.2.0",
  "identifier": "com.ytlite.desktop",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "ext/ublock/uBlock0.chromium": "ext/ublock/uBlock0.chromium"
    }
  }
}
